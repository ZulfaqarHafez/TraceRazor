{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZulfaqarHafez/TraceRazor/schemas/tracerazor_run_receipt.schema.json",
  "title": "TraceRazor run receipt (tracerazor-run-receipt/v1)",
  "description": "run-receipt.json in .tracerazor/runs/<run-id>/. Mirrors the Rust RunReceiptV1 type; every receipt is written by the native CLI (the lifecycle hook, or `tracerazor agent write-receipt` for the Python runtime) and checked by `tracerazor agent verify-receipt`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "created_at", "privacy", "hermetic", "replayable",
    "verification_mode", "audit_trace_sha256", "persisted_trace_sha256",
    "report_sha256", "signed"
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "properties": {
    "schema_version": { "const": "tracerazor-run-receipt/v1" },
    "run_id": { "$ref": "#/$defs/id" },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "session_id": { "$ref": "#/$defs/id" },
    "agent_id": { "$ref": "#/$defs/id" },
    "parent_agent_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string" },
    "privacy": { "enum": ["local-redacted", "raw"] },
    "hermetic": { "type": "boolean" },
    "replayable": { "type": "boolean" },
    "verification_mode": { "enum": ["hermetic_replay", "non_replayable_receipt"] },
    "audit_trace_sha256": { "$ref": "#/$defs/sha256" },
    "persisted_trace_sha256": { "$ref": "#/$defs/sha256" },
    "report_sha256": { "$ref": "#/$defs/sha256" },
    "signed": { "type": "boolean" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "public_key", "signature"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "public_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  }
}
