{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZulfaqarHafez/tracerazor/blob/main/schemas/trace.schema.json",
  "title": "TraceRazor native trace",
  "description": "An LLM-agent execution trace in TraceRazor's native format. See docs/trace-format.md.",
  "type": "object",
  "required": ["trace_id", "agent_name", "framework", "steps"],
  "properties": {
    "trace_id": { "type": "string", "minLength": 1 },
    "agent_name": { "type": "string" },
    "framework": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "Summed from steps when absent or zero."
    },
    "task_value_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 1.0,
      "description": "Task-completion quality; gates the TAS ceiling (x0.7 at 0.0)."
    },
    "metadata": {
      "type": "object",
      "description": "Free-form. metadata.task (or goal/objective) anchors the goal-oriented metrics (GAR, TPE)."
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["id", "content", "tokens"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Unique within the trace."
        },
        "type": {
          "type": "string",
          "enum": ["reasoning", "tool_call", "handoff", "unknown"],
          "default": "unknown"
        },
        "content": { "type": "string" },
        "tokens": { "type": "integer", "minimum": 0 },
        "tool_name": { "type": "string" },
        "tool_params": { "type": "object" },
        "tool_success": { "type": "boolean" },
        "tool_error": { "type": "string" },
        "agent_id": { "type": "string" },
        "input_context": {
          "type": "string",
          "description": "New user/environment input this step responds to; exempts the step from redundancy flagging against pre-context steps."
        },
        "output": { "type": "string" }
      }
    }
  }
}
