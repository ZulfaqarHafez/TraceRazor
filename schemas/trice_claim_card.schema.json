{
  "$id": "https://tracerazor.dev/schemas/trice_claim_card.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRICE deterministic claim card",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "scope",
    "claim_level",
    "claim_allowed",
    "determinism_contract_score",
    "input_sha256",
    "metrics",
    "requirements",
    "verification",
    "non_claims",
    "claim_card_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "trice-claim-card/v1"
    },
    "claim_level": {
      "enum": ["failed", "smoke", "pilot", "s_tier"]
    },
    "claim_allowed": {
      "type": "boolean"
    },
    "determinism_contract_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "input_sha256": {
      "type": "object",
      "required": ["suite_result", "suite_manifest"],
      "properties": {
        "suite_result": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "suite_manifest": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["mean_input_token_savings", "clustered_savings_ci_low", "pass_regressions"]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "observed", "required"],
        "properties": {
          "name": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["ok", "error_count", "errors"],
      "properties": {
        "ok": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "non_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claim_card_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
