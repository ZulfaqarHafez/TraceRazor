{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracerazor.dev/schemas/trice_evidence_manifest.schema.json",
  "title": "TRICE evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "created_by",
    "python_version",
    "platform",
    "artifacts",
    "result_sha256",
    "canonical_result_sha256",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trice-evidence-manifest/v1"
    },
    "algorithm": { "type": "string", "minLength": 1 },
    "created_by": { "type": "string", "minLength": 1 },
    "python_version": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
