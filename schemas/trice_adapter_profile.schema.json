{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracerazor.dev/schemas/trice_adapter_profile.schema.json",
  "title": "TRICE adapter profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "command"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trice-adapter-profile/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "command"
    },
    "command": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1,
      "default": 600
    },
    "repair_timeout_s": {
      "type": "integer",
      "minimum": 1
    },
    "allow_test_edits": {
      "type": "boolean",
      "default": false
    },
    "forbidden_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": ["tests/", "test/"]
    },
    "expected_exit_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer"
      },
      "default": [0]
    },
    "agent_receipt_path": {
      "type": "string",
      "minLength": 1,
      "default": ".trice/agent_receipt.json"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  }
}
