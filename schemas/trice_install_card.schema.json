{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracerazor.dev/schemas/trice_install_card.schema.json",
  "title": "TRICE installability card",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "scope",
    "install_level",
    "install_score",
    "expected_version",
    "python_executable",
    "wheel",
    "inputs",
    "checks",
    "commands",
    "probe",
    "research_basis",
    "next_actions",
    "install_card_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "trice-install-card/v1"
    },
    "scope": {
      "type": "string"
    },
    "install_level": {
      "enum": [
        "full_cli_install_ready",
        "python_trice_install_ready",
        "install_unusable"
      ]
    },
    "install_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "expected_version": {
      "type": "string"
    },
    "python_executable": {
      "type": "string"
    },
    "wheel": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "passed", "observed", "required"],
        "properties": {
          "name": {"type": "string"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "commands": {
      "type": "object"
    },
    "probe": {
      "type": "object"
    },
    "research_basis": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "install_card_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
