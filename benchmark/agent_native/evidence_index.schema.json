{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracerazor.dev/schemas/agent-native-evidence-index-v1.json",
  "title": "TraceRazor signed receipt evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "protocol_sha256",
    "task_manifest_sha256",
    "receipts"
  ],
  "properties": {
    "schema_version": {
      "const": "tracerazor-agent-evidence-index/v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "task_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256",
        "report_path",
        "trace_path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "run",
            "verifier",
            "adjudication"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "trace_path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
