# Rust build output
/target

# Database files
*.db
tracerazor.db/
.tracerazor/

# Secrets
.env

# Python build artifacts
dist/
*.egg-info/
__pycache__/
*.pyc
build/

# Build / run logs
*.log

# Claude local settings (but the checked-in project skill stays tracked)
.claude/*
!.claude/skills/

# Benchmark runner intermediates (canonical runs are committed under python_results/)
/results/*.json

# Teacher demo artifacts
examples/teacher_playbook.json

# Wheel build artifacts (the binary is bundled at build time, never committed)
tracerazor/bin/tracerazor
tracerazor/bin/tracerazor.exe
