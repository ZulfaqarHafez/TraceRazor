# Rust build output
target/

# Local Python/release outputs. The Linux auditor is copied explicitly from
# the native-builder stage, so a stale host binary must never leak into a
# different platform wheel.
build/
dist/
tracerazor/bin/tracerazor
tracerazor/bin/tracerazor.exe
**/__pycache__/
.pytest_cache/
.tracerazor/

# Node dependencies and build output
dashboard/node_modules/
dashboard/dist/

# Secrets — never bake into image
.env

# Git and IDE
.git/
.gitignore
.github/
.vscode/

# Docs and misc
*.md
*.docx
TraceRazor_PRD*

# The agent wheel is built inside Docker and requires its package readme and
# canonical skill/plugin Markdown even though the rest of the docs stay out.
!README.md
!THIRD_PARTY_NOTICES.md
!skills/tracerazor/SKILL.md
!.agents/skills/tracerazor/SKILL.md
!plugins/tracerazor/skills/tracerazor/SKILL.md
!extensions/claude-code/tracerazor/skills/tracerazor/SKILL.md
!extensions/gemini-cli/tracerazor/skills/tracerazor/SKILL.md
!crates/tracerazor-cli/assets/tracerazor-skill/SKILL.md

# Test artifacts
tracerazor-reports/
*.db
